{
  "name": "x-visu",
  "version": "1.0.0",
  "description": "A retro console-inspired music visualizer built with JavaScript, HTML5 Canvas, and the Web Audio API.",
  "main": "main.js",
  "scripts": {
  "dev": "vite",
  "build": "vite build",
  "preview": "vite preview",
  "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
  "package": "npm run build && electron-forge package",
  "make": "npm run build && electron-forge make"
},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cahillhowell/x-visu.git"
  },
  "keywords": [],
  "author": "Cahill Howell",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/cahillhowell/x-visu/issues"
  },
  "homepage": "https://github.com/cahillhowell/x-visu#readme",
  "dependencies": {
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "icon": "./build/icon"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "x_visu"
          }
        }
      ]
    }
  }
}
